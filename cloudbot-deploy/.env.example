# ============================================
# CLOUDBOT/MOLDBOT CONFIGURATION
# ============================================
# SECURITY: Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================

# === LLM API Keys ===
# Preferencia: usa Anthropic. OpenAI como respaldo opcional.
# Configura límite de gasto en: console.anthropic.com/settings/billing
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Opcional - solo si necesitas modelos GPT específicos
OPENAI_API_KEY=

# === Telegram Configuration ===
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram user ID (get from @userinfobot)
# CRITICAL: Only these IDs can control the bot
# Multiple IDs separated by comma: 123456,789012
TELEGRAM_ALLOWED_USERS=YOUR_TELEGRAM_USER_ID

# === Model Configuration ===
# JERARQUÍA DE COSTOS (Anthropic, más barato → más caro):
#   claude-3-haiku-20240307      → $0.25/1M input  ← DEFECTO (tareas rutinarias)
#   claude-3-5-sonnet-20241022   → $3.00/1M input  ← análisis complejo
#   claude-opus-4-5-20251101     → $15.0/1M input  ← NUNCA como defecto 24/7
#
# NUNCA uses Opus como modelo por defecto en un bot 24/7.
# Te quemará el crédito igual que pasó ayer.
DEFAULT_MODEL=claude-3-haiku-20240307

# Escalar a Sonnet solo si la tarea lo requiere explícitamente
ESCALATION_MODEL=claude-3-5-sonnet-20241022

# Fallback si falla el proveedor principal
FALLBACK_MODEL=claude-3-haiku-20240307

# === Token Limits (Control de Costo) ===
# Haiku: 50k tokens/día ≈ $0.015/día ≈ $0.45/mes
MAX_TOKENS_PER_REQUEST=800
MAX_CONTEXT_TOKENS=4000
DAILY_TOKEN_BUDGET=50000

# Alerta cuando se alcanza el 80% del presupuesto diario
DAILY_BUDGET_ALERT_THRESHOLD=0.80

# Límite mensual en USD - el bot se pausa si lo supera
MONTHLY_COST_LIMIT_USD=5.00

REQUESTS_PER_MINUTE=20

# === Security Settings ===
# WARNING: Enable with extreme caution
# Code execution allows the agent to run arbitrary code on your server
ENABLE_CODE_EXECUTION=false

# Web browsing is generally safe
ENABLE_WEB_BROWSING=true

# File system access - restrict to specific directories
ENABLE_FILE_ACCESS=false
ALLOWED_DIRECTORIES=/home/moldbot/workspace,/tmp/cloudbot

# === Web UI Configuration ===
WEB_UI_ENABLED=true
WEB_UI_PORT=3000
WEB_UI_HOST=127.0.0.1

# CHANGE THIS - use a strong password
WEB_UI_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!

# Session timeout in minutes
WEB_UI_SESSION_TIMEOUT=60

# === Redis Configuration (Optional) ===
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379

# === Logging ===
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/app/logs/cloudbot.log

# Conversation logging (for debugging)
# WARNING: May contain sensitive information
LOG_CONVERSATIONS=false

# === Rate Limiting ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_TOKENS_PER_MINUTE=50000

# === Webhook (Optional) ===
# For integrations with other services
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# === Timezone ===
TZ=America/Mexico_City
