# ============================================
# Cloudbot .gitignore
# ============================================

# Environment files (contain secrets)
.env
.env.local
.env.*.local
*.env

# Config files with secrets
config/config.yaml
config/config.yml
config/config.local.yaml

# Logs
logs/
*.log

# Data directory
data/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
ENV/

# Docker
.docker/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Secrets (extra protection)
*.pem
*.key
*.crt
credentials.json
secrets.yaml
secrets.yml
